{
  "name": "@les-cabochons/ajc-jira",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "corepack pnpm build && node scripts/package-connector.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "corepack pnpm test && corepack pnpm typecheck && corepack pnpm package"
  },
  "devDependencies": {
    "@ajour/plugin-sdk": "file:vendor/ajour-plugin-sdk-0.1.0.tgz",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "tar": "7.5.13",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
