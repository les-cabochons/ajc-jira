{
  "name": "@les-cabochons/ajc-jira",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "package": "corepack pnpm build && node scripts/package-connector.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "corepack pnpm test && corepack pnpm typecheck && corepack pnpm package"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tar": "7.5.13",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
